{
  "alwaysShowScrollBars": true,
  "boolDisplay": "yesNo",
  "charts": {
    "palette": [
      "#000000"
    ]
  },
  "checkForUpdates": false,
  "editor": {
    "autoIndent": false,
    "autoPairBrackets": false,
    "autoPairQuotes": false,
    "codeFolding": false,
    "completionKeywordCase": "lower",
    "completionMaximumItems": 201,
    "completionMinimumCharacters": 2,
    "completionTrigger": "afterDotAndIdentifiers",
    "fontFamily": "Menlo",
    "fontSize": 14,
    "highlightCurrentLine": false,
    "insertSpacesForTab": false,
    "lineNumbers": false,
    "minimumLinesToFold": 4,
    "offerSqlListChip": false,
    "showRunButtonsInGutter": false,
    "sqlListQuoteStyle": "double",
    "syntaxTheme": "vivid",
    "tabSize": 3,
    "wordWrap": true
  },
  "nullDisplay": "null",
  "query": {
    "confirmDestructive": false,
    "defaultLimit": 1001,
    "destructiveConfirmations": {
      "alter": false,
      "delete": false,
      "dropObject": false,
      "grant": false,
      "insert": false,
      "truncate": false,
      "update": false
    },
    "errorSheetTrigger": "never",
    "failureAlertStyle": "silent",
    "notifyMinDurationSeconds": 6,
    "notifyWhenAppInactive": false,
    "notifyWhenBackgroundTab": false,
    "restoreOpenTabs": false,
    "runScope": "wholeBuffer",
    "showCancelledQueryDialog": false,
    "timeoutSeconds": 301
  },
  "results": {
    "allowInlineEditing": false,
    "alternatingRowColors": false,
    "columnWidthMode": "fixed",
    "copyIncludeHeaders": false,
    "copyRichText": false,
    "defaultCopyFormat": "markdown",
    "density": "comfortable",
    "escapeControlCharacters": false,
    "findMatchCase": true,
    "findMode": "regularExpression",
    "fixedColumnWidth": 201,
    "fontSize": 13,
    "gridLines": "horizontal",
    "maximumCellCharacters": 1,
    "maximumColumnWidth": 1001,
    "maximumResultTabs": 1,
    "monospacedFont": false,
    "nullStyle": "dimmed",
    "showColumnTypeIcons": true,
    "showResultTabsPanelByDefault": false,
    "showRowNumbers": false
  },
  "showLeafPartitions": true,
  "theme": "dark",
  "updates": {
    "channel": "preRelease",
    "checkFrequency": "weekly"
  },
  "useAppleIntelligence": false,
  "verticalResultTabs": false
}
