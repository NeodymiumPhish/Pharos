{
  "alwaysShowScrollBars": true,
  "boolDisplay": "yesNo",
  "charts": {
    "palette": [
      "#000000"
    ]
  },
  "checkForUpdates": false,
  "editor": {
    "fontFamily": "Menlo",
    "fontSize": 14,
    "lineNumbers": false,
    "tabSize": 3,
    "wordWrap": true
  },
  "nullDisplay": "null",
  "query": {
    "confirmDestructive": false,
    "defaultLimit": 1001,
    "notifyMinDurationSeconds": 6,
    "notifyWhenAppInactive": false,
    "notifyWhenBackgroundTab": false,
    "restoreOpenTabs": false,
    "showCancelledQueryDialog": false,
    "timeoutSeconds": 301
  },
  "results": {
    "allowInlineEditing": false,
    "alternatingRowColors": false,
    "columnWidthMode": "fixed",
    "copyIncludeHeaders": false,
    "copyRichText": false,
    "defaultCopyFormat": "markdown",
    "density": "comfortable",
    "escapeControlCharacters": false,
    "findMatchCase": true,
    "findMode": "regularExpression",
    "fixedColumnWidth": 201,
    "fontSize": 13,
    "gridLines": "horizontal",
    "maximumCellCharacters": 1,
    "maximumColumnWidth": 1001,
    "maximumResultTabs": 1,
    "monospacedFont": false,
    "nullStyle": "dimmed",
    "showColumnTypeIcons": true,
    "showResultTabsPanelByDefault": false,
    "showRowNumbers": false
  },
  "showLeafPartitions": true,
  "theme": "dark",
  "updates": {
    "channel": "preRelease",
    "checkFrequency": "weekly"
  },
  "useAppleIntelligence": false,
  "verticalResultTabs": false
}
