[
  {"id": "de-customers", "schema": "sales", "request": "all customers from Germany",
   "tables": [["customers"]], "match": ["'DE'|germany"]},
  {"id": "recent-orders", "schema": "sales", "request": "orders placed in the last 7 days",
   "tables": [["orders"]], "match": ["interval|current_date|now\\(\\)"]},
  {"id": "orders-per-status", "schema": "sales", "request": "number of orders per status",
   "tables": [["orders"]], "match": ["group by", "count\\("]},
  {"id": "revenue-per-customer", "schema": "sales", "request": "total revenue per customer, highest first",
   "tables": [["customers"], ["order_items", "order_totals"]], "match": ["sum\\(", "order by"]},
  {"id": "top-products", "schema": "sales", "request": "top 5 products by quantity sold",
   "tables": [["products"], ["order_items"]], "match": ["limit 5", "sum\\("]},
  {"id": "no-orders", "schema": "sales", "request": "customers who have never placed an order",
   "tables": [["customers"], ["orders"]], "match": ["not exists|left join|not in|except"]},
  {"id": "rating-per-category", "schema": "sales", "request": "average review rating per product category",
   "tables": [["product_reviews"], ["products"], ["categories"]], "match": ["avg\\("]},
  {"id": "employee-departments", "schema": "hr", "request": "employees and their department names",
   "tables": [["employees"], ["departments"]], "match": []},
  {"id": "employee-managers", "schema": "hr", "request": "each employee with their manager's name",
   "tables": [["employees"]], "match": ["employees.*employees|manager_id"]},
  {"id": "contractors-2023", "schema": "hr", "request": "contractors hired in 2023",
   "tables": [["employees"]], "match": ["'contractor'", "2023"]},
  {"id": "python-experts", "schema": "hr", "request": "employees who know Python at level 4 or higher",
   "tables": [["employees"], ["employee_skills"], ["skills"]], "match": ["python", ">= ?4|> ?3"]},
  {"id": "promo-orders", "schema": "sales", "request": "orders that used a promotion, with the promotion code",
   "tables": [["order_promotions"], ["promotions"]], "match": ["code"]},
  {"id": "shipped-tracking", "schema": "sales", "request": "shipped orders with their carrier and tracking number",
   "tables": [["shipments"]], "match": ["carrier", "tracking_no"]},
  {"id": "stock-levels", "schema": "sales", "request": "stock level of each product in each warehouse, with product and warehouse names",
   "tables": [["inventory"], ["products"], ["warehouses"]], "match": ["quantity"]},
  {"id": "account-managers", "schema": "sales", "request": "customers and the full name of their account manager",
   "tables": [["customers"], ["employees"]], "match": ["account_manager_id"]},
  {"id": "returns-last-month", "schema": "sales", "request": "return requests from the last month with the customer name",
   "tables": [["returnrequests"], ["orders"], ["customers"]], "match": ["interval|current_date|now\\(\\)|date_trunc"]},
  {"id": "monthly-revenue", "schema": "sales", "request": "revenue by month for this year",
   "tables": [["order_items", "order_totals", "payments"]], "match": ["date_trunc|extract|to_char|date_part"]},
  {"id": "discontinued-in-stock", "schema": "sales", "request": "discontinued products that are still in stock somewhere",
   "tables": [["products"], ["inventory"]], "match": ["discontinued", "quantity"]},
  {"id": "customers-per-region", "schema": "sales", "request": "how many customers there are in each world region",
   "tables": [["customers"], ["countries"]], "match": ["region", "count\\("]},
  {"id": "salary-history", "schema": "hr", "request": "salary history for Ada Lovelace, oldest first",
   "tables": [["salary_history"], ["employees"]], "match": ["ada", "order by"]},
  {"id": "payments-by-method", "schema": "sales", "request": "total payments by method this quarter",
   "tables": [["payments"]], "match": ["method", "quarter|interval|date_trunc"]},
  {"id": "cancelled-value", "schema": "sales", "request": "total value of cancelled or refunded orders per customer country",
   "tables": [["orders"], ["customers"], ["order_items", "order_totals"]], "match": ["'cancelled'", "'refunded'"]}
]
